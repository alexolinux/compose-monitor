# ==========================================
# Environment & Secrets (NEVER COMMIT THESE)
# ==========================================
.env
.env.*
!.env.example
!.env.template

# Local certificates & keys
*.pem
*.key
*.crt
*.pub

# ==========================================
# Docker & Container Engine Files
# ==========================================
# Local Docker Compose overrides
docker-compose.override.yml
docker-compose.local.yml

# Docker / Podman logs & temp files
*.log
.docker/
docker-volumes/

# Devcontainers local state
.devcontainer/local-features/
.devcontainer/*/node_modules/

# ==========================================
# OS & IDE Generated Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.lsbfsum

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains / IntelliJ / PyCharm
.idea/

# ==========================================
# Dependencies & Build Artifacts (Host Side)
# ==========================================
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Go
/vendor/
*.exe
*.exe?
*.dll
*.so
*.dylib

# Target / Build outputs
dist/
build/
out/
target/
